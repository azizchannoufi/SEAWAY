{
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local", ".env.*local"]
    }
  ],
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json", "**/.*", "**/node_modules/**", "functions/**", "scripts/**", "package*.json",
      "*.rules", "*.md", "assets/*.png", "assets/*.jpg"
    ],
    "rewrites": [
      { "source": "/sitemap.xml", "function": { "functionId": "sitemap", "region": "europe-west1" } },
      { "source": "/product/**", "destination": "/product.html" },
      { "source": "/collections/**", "destination": "/shop.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
        ]
      },
      { "source": "/admin/**", "headers": [{ "key": "X-Frame-Options", "value": "DENY" }, { "key": "Cache-Control", "value": "no-store" }] },
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }] },
      { "source": "/assets/img/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
