# Copy to functions/.env and fill in. Never commit the real .env file.
# `firebase deploy --only functions` uploads it with the functions.

# Public URL of the shop (no trailing slash). Used in sitemap + Stripe return URLs.
SITE_URL=https://www.seaway.example
# Extra origins allowed to start a Stripe checkout (comma separated). Defaults to SITE_URL.
ALLOWED_ORIGINS=https://www.seaway.example,https://your-project.web.app

# ── Order emails (any SMTP: Brevo, Mailgun, Gmail app password, OVH…) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Seaway <orders@seaway.example>
REPLY_TO=hello@seaway.example
# Receives a "new order" email (leave empty to disable)
ADMIN_EMAIL=hello@seaway.example

# ── Stripe (optional) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal server-side verification (optional but recommended) ──
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=live

# ── Telegram alert on new orders (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
